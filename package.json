{
  "name": "statry",
  "version": "1.3.1",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    "types": "./dist/main.d.ts",
    "import": "./dist/main.js"
  },
  "author": "David Bonnet <david@bonnet.cc>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nevoland/statry.git"
  },
  "keywords": [
    "state machine",
    "state",
    "event",
    "finite state machine",
    "finite automata",
    "event emitter",
    "event handler"
  ],
  "files": [
    "dist",
    "lib",
    "!lib/old",
    "!lib/**/*.test.ts?",
    "!src",
    "!src/old",
    "README.md",
    "doc/",
    "!doc/.nojekyll"
  ],
  "imports": {
    "#lib": "./lib/main.ts",
    "#lib/": "./lib/"
  },
  "scripts": {
    "with": "node --env-file=${npm_config_env:-.env.local} $(which npm)",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=${ENV_PATH:-.env.local} src/server/main.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=${ENV_PATH:-.env} src/server/main.ts",
    "dev:test": "vitest --update --root=./",
    "test": "npm run lint && npm run format && vitest run --root=./ --coverage",
    "build:lib": "rm -rf dist; tsc --project tsconfig.package.json",
    "build:doc": "typedoc --tsconfig tsconfig.package.json",
    "build:doc:save": "typedoc --tsconfig tsconfig.package.json && git add -A && git commit -a -m 'Update doc'",
    "build:app": "vite build",
    "prepare": "npm run build:lib",
    "format": "prettier --check './**/*.{css,scss,md,mdx,json,tsx,ts,jsx,js}'",
    "format:fix": "prettier --write './**/*.{css,scss,md,mdx,json,tsx,ts,jsx,js}'",
    "lint": "npm run lint:ts",
    "lint:fix": "npm run lint:ts:fix",
    "lint:ts": "eslint .",
    "lint:ts:fix": "eslint --fix .",
    "release:init": "npm publish --access=public",
    "release:patch": "npm version patch && git push origin --follow-tags && npm publish",
    "release:minor": "npm version minor && git push origin --follow-tags && npm publish",
    "release:major": "npm version major && git push origin --follow-tags && npm publish",
    "release:alpha": "npm version prerelease --preid=alpha && git push origin --follow-tags && npm publish --tag=next",
    "release:beta": "npm version prerelease --preid=beta && git push origin --follow-tags && npm publish --tag=next"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nevoland/get-global": "^2.1.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "cssnano": "^8.0.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-vitest": "^0.5.4",
    "futurise": "^2.1.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.22",
    "postcss-pseudo-classes": "^0.4.0",
    "preact": "^10.29.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "realue": "^5.0.0-alpha.47",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.0",
    "unchangeable": "^2.2.0",
    "vite": "^8.1.5",
    "vite-plugin-module-list": "^2.6.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-http": "^11.0.0"
  }
}
